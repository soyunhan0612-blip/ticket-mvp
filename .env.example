# AI 라우트 세 곳이 이 키 하나를 공유한다.
#   POST /api/ai/description      셀러 등록 설명 생성   Haiku 4.5
#   POST /api/admin/ai-summary    운영 요약             Haiku 4.5
#   POST /api/admin/agent         운영 질문 Agent       Opus 5
# Agent만 모델이 다르다 — 무엇을 조회할지 스스로 골라야 하는 자리라
# 질문 한 번에 Tool 루프가 최대 4회 돈다. 단가가 나머지 둘보다 높다.
# 비워 두면 세 곳 모두 500이 아니라 200 + 고정 문장으로 폴백한다.
ANTHROPIC_API_KEY=

# Redis 영속화 URL (Day 9)
UPSTASH_REDIS_REST_URL=

# Redis 영속화 인증 토큰 (Day 9)
UPSTASH_REDIS_REST_TOKEN=

# /admin·/seller 미들웨어 Basic Auth 사용자명·비밀번호 (Day 8)
# 두 값 중 하나라도 비어 있으면 /admin·/seller는 401로 닫힌다.
# 빈 값은 인증 통과가 아니라 거부로 처리된다 (src/lib/basic-auth.ts).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
