# AI 라우트 세 곳이 이 키 하나를 공유한다.
#   POST /api/ai/description      셀러 등록 설명 생성   Haiku 4.5
#   POST /api/admin/ai-summary    운영 요약             Haiku 4.5
#   POST /api/admin/agent         운영 질문 Agent       Opus 5
# Agent만 모델이 다르다 — 무엇을 조회할지 스스로 골라야 하는 자리라
# 질문 한 번에 Tool 루프가 최대 4회 돈다. 단가가 나머지 둘보다 높다.
# 비워 두면 세 곳 모두 500이 아니라 200 + 고정 문장으로 폴백한다.
ANTHROPIC_API_KEY=

# Redis 영속화 URL (Day 9)
UPSTASH_REDIS_REST_URL=

# Redis 영속화 인증 토큰 (Day 9)
UPSTASH_REDIS_REST_TOKEN=

# /admin·/seller 미들웨어 Basic Auth 사용자명·비밀번호 (Day 8)
# 두 값 중 하나라도 비어 있으면 /admin·/seller는 401로 닫힌다.
# 빈 값은 인증 통과가 아니라 거부로 처리된다 (src/lib/basic-auth.ts).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# 관람객 챗봇의 Slack 상담원 연결에 쓰는 서버 전용 설정이다.
# SLACK_BOT_TOKEN이나 SLACK_CHANNEL_ID가 비어 있으면 챗봇은 AI 답변만 제공하고 상담원 연결이 꺼진다.
# 그 둘만 채우고 SLACK_SIGNING_SECRET을 비워 두면 상담 요청은 슬랙으로 나가지만 상담원 답장이 전부 거부되어
# 손님이 대기 상태에 갇힌다. 세 값을 함께 채워야 왕복이 성립한다.
# SLACK_BOT_TOKEN에는 전송용 chat:write와 답장 수신용 history 스코프가 모두 필요하다.
# 공개 채널은 channels:history, 비공개 채널은 groups:history를 부여하고 봇을 대상 채널에 초대한다.
# chat:write만으로는 상담원의 스레드 답장이 앱에 들어오지 않는다.
# SLACK_SIGNING_SECRET은 들어오는 답장의 서명을 검증하며, 비어 있으면 콜백을 모두 거부한다(fail-closed).
# NEXT_PUBLIC_ 접두사를 붙이면 브라우저 번들에 평문으로 노출되므로 절대 붙이지 않는다.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
